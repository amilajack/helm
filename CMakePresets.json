  "buildPresets": [
    {"name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "targets": ["HelmPlugin_VST3", "HelmPlugin_AU", "HelmStandalone"]},
    {"name": "macos-arm64-release", "configurePreset": "macos-arm64-release", "targets": ["HelmPlugin_VST3", "HelmPlugin_AU", "HelmStandalone"]}
  ]
}
