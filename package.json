{
  "name": "helm",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "bash web/scripts/build.sh && python3 web/scripts/package-static.py",
    "typecheck": "pnpm --dir web typecheck",
    "test:browser": "pnpm --dir web test",
    "test:distribution": "HELM_TEST_DISTRIBUTION=1 pnpm --dir web test"
  }
}
